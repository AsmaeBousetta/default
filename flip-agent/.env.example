# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Scheduler ──────────────────────────────────────────────────────────────────
CHECK_INTERVAL_HOURS=4          # fréquence de scraping (heures)

# ── Notifications ──────────────────────────────────────────────────────────────
# Choisir au moins un canal (email ou Discord, ou les deux)

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=youraddress@gmail.com
SMTP_TO=alerts@yourdomain.com

# Discord Webhook (laisser vide pour désactiver)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ── Mode ──────────────────────────────────────────────────────────────────────
DRY_RUN=false                   # true = ne pas envoyer d'alertes

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_PATH=flip_agent.db

# ── Scraping ──────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
REQUEST_DELAY_MIN=2             # secondes (délai min entre requêtes)
REQUEST_DELAY_MAX=5             # secondes (délai max entre requêtes)
MAX_PAGES_PER_RUN=10            # pages max à scraper par catégorie par run
